---
layout: layout.njk
pagination:
  data: collections.categories
  size: 1
  alias: category
permalink: "/category/{{ category | slug }}/index.html"

eleventyComputed:
  title: "{{ category }} News"
  description: "Latest {{ category }} stories and coverage from TT Media."
---

<section class="page-shell">
  <div class="eyebrow">Section</div>
  <h1>{{ category }}</h1>
  <p>Stay updated with the latest {{ category | lower }} reporting, analysis, and breaking developments from TT Media.</p>
</section>

<section class="section">
  <div class="stacked-list">
    {% for post in collections.posts | reverse %}
      {% if post.data.category == category %}
        <article class="story-row">
          <div class="story-row__content">
            <div class="story-card__meta">
              <span>{{ post.data.category }}</span>
              <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
            </div>
            <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
            <p>{{ post.data.description or post.templateContent | striptags | truncate(180) }}</p>
          </div>
          <div class="story-row__badge">{{ post.data.category }}</div>
        </article>
      {% endif %}
    {% endfor %}
  </div>
</section>

<div class="ad-slot ad-slot--top-leaderboard">
  <span>AdSense Category Slot</span>
</div>
