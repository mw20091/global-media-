<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>The Daily Ledger – Breaking News & Analysis</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f6f6f4; --card:#ffffff; --text:#14181f; --muted:#667085; --line:#e4e4e0;
  --brand:#c8102e; --brand-dark:#9b0c23; --ink:#0b1220; --ad-bg:#eceae4;
  --serif:'Playfair Display',Georgia,serif; --sans:'Inter',system-ui,sans-serif;
}
@media (prefers-color-scheme:dark){
  :root{--bg:#0e1116; --card:#161a22; --text:#eef0f4; --muted:#98a2b3; --line:#262c38; --ad-bg:#1d222c; --ink:#05070b}
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:var(--sans);background:var(--bg);color:var(--text);line-height:1.5}
a{color:inherit;text-decoration:none}
a:hover h1,a:hover h2,a:hover h3{color:var(--brand)}
.wrap{max-width:1240px;margin:0 auto;padding:0 20px}
.topbar{background:var(--ink);color:#cfd4dc;font-size:12px}
.topbar .wrap{display:flex;justify-content:space-between;align-items:center;height:36px}
.topbar a{margin-left:16px;opacity:.85}.topbar a:hover{opacity:1}
.ticker{background:var(--brand);color:#fff;font-size:13px;font-weight:600}
.ticker .wrap{display:flex;align-items:center;height:38px;gap:14px;overflow:hidden}
.ticker b{background:#fff;color:var(--brand);padding:2px 10px;border-radius:3px;font-size:11px;letter-spacing:.08em;flex:none}
.ticker span{white-space:nowrap;animation:scroll 40s linear infinite}
@keyframes scroll{from{transform:translateX(100%)}to{transform:translateX(-100%)}}
header.main{background:var(--card);border-bottom:1px solid var(--line)}
.masthead{display:flex;align-items:center;justify-content:space-between;padding:22px 0}
.logo{font-family:var(--serif);font-weight:900;font-size:40px;letter-spacing:-.02em}
.logo em{color:var(--brand);font-style:normal}
.actions{display:flex;gap:10px;align-items:center}
.search{border:1px solid var(--line);background:var(--bg);color:var(--text);padding:9px 14px;border-radius:999px;font-size:14px;width:220px}
.btn{background:var(--brand);color:#fff;border:0;padding:10px 18px;border-radius:999px;font-weight:600;font-size:14px;cursor:pointer}
.btn:hover{background:var(--brand-dark)}
nav.cats{border-top:1px solid var(--line)}
nav.cats .wrap{display:flex;gap:26px;overflow-x:auto;scrollbar-width:none}
nav.cats a{padding:13px 0;font-size:14px;font-weight:600;white-space:nowrap;border-bottom:3px solid transparent}
nav.cats a:hover,nav.cats a.active{border-color:var(--brand);color:var(--brand)}
.ad{background:var(--ad-bg);border:1px dashed var(--muted);color:var(--muted);display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:12px;text-align:center;border-radius:4px;margin:0 auto}
.ad small{font-size:10px;letter-spacing:.12em;text-transform:uppercase;opacity:.7}
.ad strong{font-size:14px;color:var(--text);margin:2px 0}
.ad-leader{width:100%;max-width:728px;height:90px;margin:22px auto}
.ad-rect{width:300px;height:250px}
.ad-sky{width:300px;height:600px}
.ad-infeed{width:100%;height:120px;margin:10px 0}
.ad-mobile{display:none;width:320px;height:50px}
.img{background:linear-gradient(135deg,#2b3445,#566179);position:relative;overflow:hidden;border-radius:6px}
.img::after{content:"IMAGE";position:absolute;inset:0;display:grid;place-items:center;color:rgba(255,255,255,.35);font-size:12px;letter-spacing:.2em;font-weight:600}
.img.c2{background:linear-gradient(135deg,#7a1f2b,#c8102e)}
.img.c3{background:linear-gradient(135deg,#0f4c5c,#2a9d8f)}
.img.c4{background:linear-gradient(135deg,#4a3b78,#8a6fd1)}
.img.c5{background:linear-gradient(135deg,#7a5c14,#e0a800)}
.tag{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--brand);margin-bottom:6px}
.meta{font-size:12px;color:var(--muted)}
.hero{display:grid;grid-template-columns:2fr 1fr;gap:24px;margin-bottom:34px}
.lead .img{aspect-ratio:16/9}
.lead h1{font-family:var(--serif);font-size:38px;line-height:1.15;margin:14px 0 10px}
.lead p{color:var(--muted);font-size:16px;margin-bottom:8px}
.stack{display:flex;flex-direction:column;gap:18px}
.stack article{display:grid;grid-template-columns:110px 1fr;gap:14px;padding-bottom:18px;border-bottom:1px solid var(--line)}
.stack article:last-child{border:0}
.stack .img{aspect-ratio:1}
.stack h3{font-size:16px;line-height:1.3;margin-bottom:4px}
.layout{display:grid;grid-template-columns:1fr 300px;gap:34px}
.section-title{display:flex;align-items:center;gap:12px;margin:8px 0 18px;font-family:var(--serif);font-size:26px}
.section-title::after{content:"";flex:1;height:2px;background:var(--line)}
.section-title::before{content:"";width:8px;height:26px;background:var(--brand);border-radius:2px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:30px}
.card{background:var(--card);border:1px solid var(--line);border-radius:8px;overflow:hidden;transition:.2s}
.card:hover{transform:translateY(-3px);box-shadow:0 10px 24px rgba(0,0,0,.1)}
.card .img{aspect-ratio:16/10;border-radius:0}
.card div.body{padding:14px}
.card h3{font-size:17px;line-height:1.3;margin-bottom:6px}
.list article{display:grid;grid-template-columns:200px 1fr;gap:18px;padding:18px 0;border-bottom:1px solid var(--line)}
.list .img{aspect-ratio:4/3}
.list h3{font-family:var(--serif);font-size:21px;line-height:1.25;margin-bottom:6px}
.list p{color:var(--muted);font-size:14px}
aside{display:flex;flex-direction:column;gap:26px}
.sticky{position:sticky;top:16px;display:flex;flex-direction:column;gap:26px}
.box{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:18px}
.box h4{font-size:14px;letter-spacing:.08em;text-transform:uppercase;margin-bottom:12px;border-bottom:2px solid var(--brand);padding-bottom:8px}
.trend{counter-reset:t}
.trend li{list-style:none;display:flex;gap:12px;padding:10px 0;border-bottom:1px solid var(--line);font-size:14px;font-weight:600}
.trend li::before{counter-increment:t;content:counter(t);font-family:var(--serif);font-size:24px;color:var(--brand);line-height:1}
.trend li:last-child{border:0}
.newsletter input{width:100%;padding:11px;border:1px solid var(--line);border-radius:6px;margin:8px 0;background:var(--bg);color:var(--text)}
.newsletter .btn{width:100%;border-radius:6px}
.brand-promo{display:grid;grid-template-columns:1fr 1fr;background:var(--ink);color:#fff;border-radius:10px;overflow:hidden;margin:34px 0}
.brand-promo .txt{padding:34px}
.brand-promo .label{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#f5b301;font-weight:700}
.brand-promo h2{font-family:var(--serif);font-size:30px;margin:10px 0}
.brand-promo p{color:#b8c0cc;margin-bottom:18px}
.brand-promo .img{border-radius:0;min-height:240px;background:linear-gradient(135deg,#c8102e,#f5b301)}
.brand-promo .img::after{content:"BRAND IMAGE / LOGO"}
.partners{display:flex;gap:14px;flex-wrap:wrap;margin:10px 0 34px}
.partners div{flex:1;min-width:140px;height:64px;background:var(--card);border:1px solid var(--line);border-radius:6px;display:grid;place-items:center;color:var(--muted);font-size:12px;font-weight:600;letter-spacing:.1em}
footer{background:var(--ink);color:#9aa3b2;margin-top:50px;padding:44px 0 20px;font-size:14px}
.fgrid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:30px;margin-bottom:30px}
footer h5{color:#fff;margin-bottom:12px;font-size:13px;letter-spacing:.1em;text-transform:uppercase}
footer a{display:block;padding:4px 0}footer a:hover{color:#fff}
.copy{border-top:1px solid #1f2735;padding-top:18px;display:flex;justify-content:space-between;font-size:12px}
.sticky-footer-ad{position:fixed;bottom:0;left:0;right:0;z-index:50;display:none;justify-content:center;background:var(--card);border-top:1px solid var(--line);padding:6px}
@media(max-width:1000px){
  .layout{grid-template-columns:1fr}
  .hero{grid-template-columns:1fr}
  .grid3{grid-template-columns:repeat(2,1fr)}
  .fgrid{grid-template-columns:1fr 1fr}
  .sticky{position:static}
}
@media(max-width:640px){
  .search{display:none}
  .logo{font-size:30px}
  .lead h1{font-size:28px}
  .grid3{grid-template-columns:1fr}
  .list article{grid-template-columns:110px 1fr}
  .list p{display:none}
  .brand-promo{grid-template-columns:1fr}
  .ad-leader{display:none}
  .ad-mobile{display:flex;margin:14px auto}
  .sticky-footer-ad{display:flex}
}
</style>
</head>
